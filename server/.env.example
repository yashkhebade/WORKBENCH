# Copy to server/.env and fill in real values. Never commit the real .env file.

PORT=3000

# Required. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Must be 32+ characters. The server refuses to start without this set.
JWT_SECRET=

DB_PATH=./database.sqlite
STORAGE_LOCATION=./uploads
MAX_FILE_SIZE_MB=50

# Comma-separated list of allowed frontend origins for CORS.
FRONTEND_URL=http://localhost:5173

# Only needed if you're using Supabase auth alongside local JWT auth.
SUPABASE_URL=
SUPABASE_ANON_KEY=
